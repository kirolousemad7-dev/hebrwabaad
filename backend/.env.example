APP_NAME="Hebr & Ab3ad"
# Production: APP_ENV=production
APP_ENV=local
APP_KEY=
# Production MUST set APP_DEBUG=false. Never ship with debug enabled.
APP_DEBUG=true
# Public API origin, e.g. https://api.example.com
APP_URL=http://localhost:8000
# Public SPA origin used in password-reset emails, e.g. https://example.com
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=error (or warning). Never log secrets.
LOG_LEVEL=debug

# Production database is MySQL. Do not deploy against SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hebr_abaad
DB_USERNAME=root
DB_PASSWORD=

# Token APIs use Sanctum personal access tokens. Session settings apply to
# any first-party web routes. Production: set SESSION_DOMAIN to the cookie
# domain or leave unset when using Bearer tokens only.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for Bearer-token APIs. Do not set this to localhost in production.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
# Private customer/employee files use the local disk (storage/app/private) by default.
# Production: set FILESYSTEM_DISK=s3 and configure AWS_* (S3 / R2 / compatible).
# Never point FILESYSTEM_DISK at the public disk for private documents.
FILESYSTEM_DISK=local
# Printing design uploads use the local private disk. If PHP reports
# "unable to create a temporary file", set upload_tmp_dir in php.ini to a
# writable path without special characters (e.g. C:/Users/.../Temp/php-uploads).
#
# Production queue: database (jobs table already migrated) or redis.
# Local/dev may keep sync. Never leave production on sync under load.
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset / OTP / quotation / invoice emails require a real mailer in production.
# Local/dev may use MAIL_MAILER=log (writes to storage/logs).
# Production: smtp (or ses / postmark / resend via Laravel mailers).
# Do not commit real credentials — set them in the host secret store.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Production SMTP example (placeholders only) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=apikey_or_user
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="no-reply@example.com"
# MAIL_FROM_NAME="Hebr & Abaad"

# SMS provider abstraction for phone verification OTPs.
# SMS_PROVIDER: log | null | http
SMS_PROVIDER=log
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
# Required when SMS_PROVIDER=http
SMS_HTTP_ENDPOINT=
SMS_HTTP_TIMEOUT=10
SMS_OTP_TTL_MINUTES=10
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RESEND_COOLDOWN=60

# Google OAuth (shared client id/secret for Calendar + Sign-in).
# Calendar connect:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/google-calendar/callback"
# Continue with Google (login/register) — must also be allowed in Google Cloud Console:
GOOGLE_AUTH_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Dedicated Gmail API sender for OTP / transactional mail (NOT used for Customer Google Login).
# Requires OAuth scope: https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Zoom Server-to-Server OAuth (video meetings). Leave empty to disable Zoom.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_REDIRECT_URI="${APP_URL}/api/zoom/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave empty when using Bearer tokens (current SPA). Comma-separated hosts
# only if first-party cookie auth is later enabled.
SANCTUM_STATEFUL_DOMAINS=
# Personal access token lifetime in minutes. Null/empty = non-expiring (dev only).
# Production recommendation: 480 (8h) to 10080 (7d). Frontend clears token on 401.
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080
# Production: exact frontend origins only, e.g. https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First Render deploy only: set RUN_DB_SEED=true to load catalog + demo accounts.
# DemoAccountSeeder is idempotent and does not overwrite existing passwords.
# RUN_DB_SEED=false
# DEMO_PASSWORD=

CONSULTANT_ENABLED=true
CONSULTANT_AI_PROVIDER=rules
OPENAI_API_KEY=
CONSULTANT_OPENAI_MODEL=gpt-4o-mini
CONSULTANT_OPENAI_TIMEOUT=12

# PayTabs Hosted Payment Page. Credentials belong only in the server .env.
# Official HPP auth is Profile ID + Server Key. Do not send card data from this app.
# MERCHANT_ID, PUBLIC_KEY, and SECRET_KEY are not used by the hosted page. Leave them empty.
# PAYTABS_ENABLED=false disables card checkout. A missing SERVER_KEY also disables it.
PAYTABS_ENABLED=true
PAYTABS_MERCHANT_ID=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_PUBLIC_KEY=
PAYTABS_SECRET_KEY=
PAYTABS_REGION=SAU
PAYTABS_CURRENCY=SAR
PAYTABS_MODE=test
PAYTABS_RETURN_URL=https://hebrwabaad.com/payment/return
PAYTABS_CALLBACK_URL=https://api.hebrwabaad.com/api/payments/paytabs/callback
# Optional. Empty uses the host for PAYTABS_REGION (SAU = https://secure.paytabs.sa).
PAYTABS_BASE_URL=
PAYTABS_ENVIRONMENT=test
PAYTABS_TIMEOUT=15

# OTO Shipping API V2. Leave disabled until a sandbox refresh token is configured.
# Default host is the sandbox. Production host is https://api.tryoto.com/rest/v2.
# OTO_ORDER_CODE is ignored. Each shipment uses the local order reference as orderId.
# The refresh token is a secret. Never put it in the frontend or in git.
OTO_ENABLED=false
OTO_API_BASE_URL=https://staging-api.tryoto.com/rest/v2
OTO_REFRESH_TOKEN=
OTO_ORDER_CODE=
OTO_PICKUP_LOCATION_CODE=
OTO_ORIGIN_CITY=Riyadh
OTO_ORIGIN_COUNTRY=SA
OTO_DEFAULT_WEIGHT_KG=1
OTO_TIMEOUT=15
OTO_WEBHOOK_SECRET=
OTO_WEBHOOK_TOLERANCE=900

# Local-only opt-in seeders (never enable in production)
# SEED_DEMO_ACCOUNTS=false
# SEED_SAMPLE_SUPPLIERS=false
# SEED_SAMPLE_PORTFOLIO=false
# DEMO_PASSWORD=
