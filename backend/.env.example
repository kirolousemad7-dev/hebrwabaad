APP_NAME="Hebr & Ab3ad"
# Production: APP_ENV=production
APP_ENV=local
APP_KEY=
# Production MUST set APP_DEBUG=false. Never ship with debug enabled.
APP_DEBUG=true
# Public API origin, e.g. https://api.example.com
APP_URL=http://localhost:8000
# Public SPA origin used in password-reset emails, e.g. https://example.com
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: LOG_LEVEL=error (or warning). Never log secrets.
LOG_LEVEL=debug

# Production database is MySQL. Do not deploy against SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hebr_abaad
DB_USERNAME=root
DB_PASSWORD=

# Token APIs use Sanctum personal access tokens. Session settings apply to
# any first-party web routes. Production: set SESSION_DOMAIN to the cookie
# domain or leave unset when using Bearer tokens only.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for Bearer-token APIs. Do not set this to localhost in production.
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
# Private customer/employee files use the local disk (storage/app/private).
# Never point FILESYSTEM_DISK at the public disk.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset emails require a real mailer in production.
# Local/dev may use MAIL_MAILER=log (writes to storage/logs).
# Production examples: smtp, ses, postmark, resend.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave empty when using Bearer tokens (current SPA). Comma-separated hosts
# only if first-party cookie auth is later enabled.
SANCTUM_STATEFUL_DOMAINS=
# Production: exact frontend origins only, e.g. https://example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First Render deploy only: set RUN_DB_SEED=true to load catalog + demo accounts.
# DemoAccountSeeder is idempotent and does not overwrite existing passwords.
# RUN_DB_SEED=false
# DEMO_PASSWORD=

CONSULTANT_ENABLED=true
CONSULTANT_AI_PROVIDER=rules
OPENAI_API_KEY=
CONSULTANT_OPENAI_MODEL=gpt-4o-mini
CONSULTANT_OPENAI_TIMEOUT=12

# PayTabs Hosted Payment Page (Visa/Mastercard). Server Key is SECRET.
# Never commit the Server Key. Never expose it to the frontend.
# TEST: PAYTABS_ENVIRONMENT=test  LIVE: PAYTABS_ENVIRONMENT=live
# Callback must be a public HTTPS URL: {APP_URL}/api/webhooks/paytabs
PAYTABS_PROFILE_ID=154601
PAYTABS_SERVER_KEY=
PAYTABS_BASE_URL=https://secure-egypt.paytabs.com
PAYTABS_ENVIRONMENT=test
PAYTABS_TIMEOUT=15
