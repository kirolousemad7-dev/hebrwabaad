# Public API origin used by the SPA.
# Local: http://127.0.0.1:8000
# Production: https://your-api.onrender.com
# Do not append /api — request paths already start with /api/...
# Required for `npm run build`. Do not leave this pointing at localhost in production.
VITE_API_URL=http://127.0.0.1:8000

# Public site origin used for canonical URLs, Open Graph, and sitemap.xml.
# Local (dev only): http://localhost:5173
# Production: https://your-production-domain.com
# Never commit a fake production domain. Set the real public HTTPS origin before release.
VITE_PUBLIC_SITE_URL=http://localhost:5173
